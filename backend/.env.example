# ─────────────────────────────────────────────────────────
# AI Image Authenticity Checker — Backend Environment Config
# Copy this file to .env and modify as needed.
# ─────────────────────────────────────────────────────────

APP_NAME="AI Image Authenticity Checker"
APP_VERSION="1.0.0"
DEBUG=False

HOST=0.0.0.0
PORT=8000

# HuggingFace model for AI-image detection
MODEL_ID=umm-maybe/AI-image-detector

# Decision thresholds (0.0 to 1.0)
# score > AI_THRESHOLD    → LIKELY AI-GENERATED
# score < REAL_THRESHOLD  → LIKELY REAL
AI_THRESHOLD=0.70
REAL_THRESHOLD=0.35

# Max upload size in MB
MAX_IMAGE_SIZE_MB=10

# Privacy: delete temp files after analysis
DELETE_AFTER_ANALYSIS=True
